---
import { Image } from 'astro:assets';
import diagram from '../assets/micro-data-center.svg';
import { home, linkedHtml } from '../data/home';
import { localePosts } from '../data/posts';
import { ui } from '../data/ui';
import Base from '../layouts/Base.astro';
import { actionIcon, localePath, locales, site, type Locale } from '../site';
import ActionIcon from './ActionIcon.astro';
import Contact from './Contact.astro';
import Icon from './Icon.astro';
import PostCard from './PostCard.astro';
import SafetyArt from './SafetyArt.astro';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const copy = home[locale];
const strings = ui[locale];
const posts = (await localePosts(locale)).slice(0, 3);
const named = (files: Record<string, { default: ImageMetadata }>) => {
	return Object.fromEntries(Object.entries(files).map(([path, file]) => [path.split('/').pop()!.split('.')[0], file.default]));
};
const logoImages = named(import.meta.glob<{ default: ImageMetadata }>('../assets/apps/*.svg', { eager: true }));
const shotImages = named(import.meta.glob<{ default: ImageMetadata }>('../assets/platform/*.png', { eager: true }));
const terminal = [
	'Usage: virgo [options] [command]',
	'',
	'virgoOS CLI',
	'',
	'Options:',
	'  -V, --version   output the version number',
	'  -h, --help      display help for command',
	'',
	'Commands:',
	'  network         Network settings',
	'  apps            Installable applications',
	'  indexer         Index and search files in ZFS snapshots',
	'  help [command]  display help for command'
];
const alternates = Object.fromEntries(locales.map((other) => [other, localePath(other)]));
const pageUrl = new URL(localePath(locale), Astro.site).href;
const schema = [
	{
		'@type': 'SoftwareApplication',
		'@id': `${site.url}/#software`,
		name: site.product,
		description: copy.meta.description,
		url: pageUrl,
		applicationCategory: 'OperatingSystem',
		operatingSystem: 'Debian',
		license: site.license,
		isAccessibleForFree: true,
		offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
		publisher: { '@id': `${site.url}/#organization` },
		sameAs: [site.github, `${site.docs}/`]
	},
	{
		'@type': 'WebPage',
		'@id': `${pageUrl}#webpage`,
		url: pageUrl,
		name: copy.meta.title,
		description: copy.meta.description,
		inLanguage: locale,
		isPartOf: { '@id': `${site.url}/#website` },
		about: { '@id': `${site.url}/#software` }
	},
	{
		'@type': 'FAQPage',
		'@id': `${pageUrl}#faq`,
		inLanguage: locale,
		mainEntity: copy.faq.items.map(({ question, answer }) => ({
			'@type': 'Question',
			name: question,
			acceptedAnswer: { '@type': 'Answer', text: linkedHtml(answer) }
		}))
	}
];
---

<Base locale={locale} title={copy.meta.title} description={copy.meta.description} alternates={alternates} schema={schema}>
	<section class="hero">
		<div class="wrap">
			<div class="hero-grid">
				<div>
					<span class="label">{copy.hero.label}</span>
					<h1>
						<span class="thin">{copy.hero.thin}</span>
						<span class="heavy">{copy.hero.heavy}</span>
					</h1>
					<hr class="spectrum hero-line">
					<p class="lede">{copy.hero.lede}</p>
					<div class="btn-row">
						<a class="btn" href={copy.hero.primary.href}><ActionIcon href={copy.hero.primary.href} />{copy.hero.primary.text}{!actionIcon(copy.hero.primary.href) && <span class="arw" aria-hidden="true">→</span>}</a>
						<a class="btn btn--ghost" href={copy.hero.secondary.href}><ActionIcon href={copy.hero.secondary.href} />{copy.hero.secondary.text}</a>
					</div>
				</div>
				<figure class="hero-shot">
					<Image src={diagram} alt={copy.hero.imageAlt} loading="eager" fetchpriority="high" />
				</figure>
			</div>
			<dl class="plate">
				{copy.hero.facts.map(({ term, value }) => (
					<div>
						<dt>{term}</dt>
						<dd>{value}</dd>
					</div>
				))}
			</dl>
		</div>
	</section>

	<section class="bay" id="features">
		<div class="wrap">
			<header class="bay-head">
				<span class="label">{copy.features.label}</span>
				<h2>{copy.features.title}</h2>
				<p class="lede">{copy.features.lede}</p>
			</header>
			<div class="caps">
				{copy.features.items.map(({ icon, logos, title, text }) => (
					<article class="cap-card">
						<div class="cap-head">
							{icon && <Icon name={icon} />}
							{logos && (
								<span class="cap-logos">
									{logos.map((logo) => <Image src={logoImages[logo]} alt="" width={44} height={44} />)}
								</span>
							)}
						</div>
						<h3>{title}</h3>
						<p>{text}</p>
					</article>
				))}
			</div>
			<p class="caps-note">{copy.features.note}</p>
		</div>
	</section>

	<section class="bay bay--tight" id="safety">
		<div class="wrap">
			<header class="bay-head">
				<span class="label">{copy.safety.label}</span>
				<h2>{copy.safety.title}</h2>
				<p class="lede">{copy.safety.lede}</p>
			</header>
			<div class="gets">
				{copy.safety.items.map(({ art, label, title, text, href }) => (
					<article>
						{art && <SafetyArt name={art} />}
						<span class="label">{label}</span>
						<h3>{title}</h3>
						<p>{text}</p>
						{href && <a class="more" href={href}>{strings.inDocs} <span class="arw" aria-hidden="true">→</span><span class="sr-only">: {title}</span></a>}
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="bay bay--tight" id="platform">
		<div class="wrap">
			<header class="bay-head">
				<span class="label">{copy.platform.label}</span>
				<h2>{copy.platform.title}</h2>
				<p class="lede">{copy.platform.lede}</p>
			</header>
			<div class="why">
				{copy.platform.items.map(({ title, text, href, shot, shotAlt }, index) => (
					<article class:list={{ 'is-active': index === 0 }}>
						<h3><button class="why-tab" type="button">{title}</button></h3>
						<div class="why-body">
							<div>
								<p>{text}</p>
								{href && <a class="more" href={href}>{strings.inDocs} <span class="arw" aria-hidden="true">→</span><span class="sr-only">: {title}</span></a>}
							</div>
						</div>
						{shot && (
							<figure class="why-shot">
								<span class="why-bar" aria-hidden="true"><i /><i /><i /></span>
								{shot.toLowerCase() === 'terminal' ? (
									<pre class="term" role="img" aria-label={shotAlt}><span class="term-line"><span class="term-prompt">voyager@spica:~$ </span><span class="term-typed">virgo --help</span><span class="term-cursor" /></span>{terminal.map((line, i) => <span class="term-line term-out" style={`--i: ${i}`}>{line}</span>)}</pre>
								) : (
									<Image src={shotImages[shot]} alt={shotAlt ?? ''} widths={[640, 1280]} sizes="(max-width: 999px) 100vw, 620px" loading="lazy" />
								)}
							</figure>
						)}
					</article>
				))}
			</div>
		</div>
	</section>

	<section class="bay bay--tight" id="faq">
		<div class="wrap">
			<header class="bay-head">
				<span class="label">{copy.faq.label}</span>
				<h2>{copy.faq.title}</h2>
			</header>
			<div class="faq">
				{copy.faq.items.map(({ question, answer }) => (
					<details>
						<summary><h3>{question}</h3></summary>
						<div class="ans"><p set:html={linkedHtml(answer)} /></div>
					</details>
				))}
			</div>
		</div>
	</section>

	{posts.length > 0 && (
		<section class="bay bay--tight" id="blog">
			<div class="wrap">
				<header class="bay-head">
					<span class="label">{strings.blog.label}</span>
					<h2>{strings.blog.latest}</h2>
				</header>
				<div class="post-feed">
					{posts.map((post) => <PostCard post={post} heading="h3" />)}
				</div>
				<div class="feed-foot">
					<a class="more" href={localePath(locale, 'blog/')}>{strings.blog.all} <span class="arw" aria-hidden="true">→</span></a>
				</div>
			</div>
		</section>
	)}

	<Contact locale={locale} />

	<section class="bay--tight">
		<div class="wrap">
			<div class="close">
				<h2>{copy.close.title}</h2>
				<p>{copy.close.text}</p>
				<div class="btn-row">
					<a class="btn" href={copy.close.primary.href}><ActionIcon href={copy.close.primary.href} />{copy.close.primary.text}{!actionIcon(copy.close.primary.href) && <span class="arw" aria-hidden="true">→</span>}</a>
					<a class="btn btn--ghost" href={copy.close.secondary.href}><ActionIcon href={copy.close.secondary.href} />{copy.close.secondary.text}</a>
				</div>
			</div>
		</div>
	</section>
</Base>

<script>
	const DURATION = 250;
	const EASING = 'cubic-bezier(0.4, 0, 0.2, 1)';
	const ROTATION = 6000;
	const why = document.querySelector<HTMLElement>('.why');
	const term = why?.querySelector<HTMLElement>('.term');
	const items = [...(why?.querySelectorAll<HTMLElement>(':scope > article') ?? [])];
	const tabbed = matchMedia('(min-width: 1000px)');
	let rotation: number | undefined;
	let rotating = true;

	const type = () => {
		if (!term) {
			return;
		}

		term.classList.remove('is-typing');
		void term.offsetWidth;
		term.classList.add('is-typing');
	};

	const activate = (item: HTMLElement) => {
		items.forEach((other) => {
			other.classList.toggle('is-active', other === item);
			const tab = other.querySelector('.why-tab');
			if (tabbed.matches) {
				tab?.setAttribute('aria-expanded', String(other === item));
			} else {
				tab?.removeAttribute('aria-expanded');
			}
		});
		if (term && item.contains(term)) {
			type();
		}
	};

	const rotate = (visible: boolean) => {
		clearInterval(rotation);
		if (visible && rotating && tabbed.matches) {
			rotation = window.setInterval(() => {
				const current = items.findIndex((item) => item.classList.contains('is-active'));
				activate(items[(current + 1) % items.length]);
			}, ROTATION);
		}
	};

	if (why && items.length > 0) {
		why.classList.add('is-tabbed');
		activate(items.find((item) => item.classList.contains('is-active')) ?? items[0]);
		tabbed.addEventListener('change', () => activate(items.find((item) => item.classList.contains('is-active')) ?? items[0]));
		items.forEach((item) => {
			item.addEventListener('click', (event) => {
				if ((event.target as Element).closest('a')) {
					return;
				}

				rotating = false;
				rotate(false);
				activate(item);
			});
		});
		new IntersectionObserver(([entry]) => rotate(entry.isIntersecting), { threshold: 0.3 }).observe(why);
	}

	if (term) {
		const seen = new IntersectionObserver(([entry]) => {
			if (entry.isIntersecting) {
				type();
				seen.disconnect();
			}
		}, { threshold: 0.5 });
		seen.observe(term);
	}

	document.querySelectorAll<HTMLDetailsElement>('.faq details').forEach((details) => {
		const summary = details.querySelector('summary');
		if (!summary) {
			return;
		}

		let expanded = details.open;
		let animation: Animation | null = null;

		summary.addEventListener('click', (event) => {
			event.preventDefault();
			expanded = !expanded;
			const start = details.offsetHeight;
			animation?.cancel();
			details.open = true;
			details.classList.toggle('is-closing', !expanded);
			const end = (expanded ? details.offsetHeight : summary.offsetHeight + details.offsetHeight - details.clientHeight);
			details.style.overflow = 'hidden';
			animation = details.animate({ height: [`${start}px`, `${end}px`] }, { duration: DURATION, easing: EASING });
			animation.onfinish = () => {
				details.open = expanded;
				details.classList.remove('is-closing');
				details.style.overflow = '';
				animation = null;
			};
		});
	});
</script>
