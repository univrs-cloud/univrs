---
import type { Locale } from '../site';

interface Props {
	locale: Locale;
}

const flags: Record<Locale, { viewBox: string; markup: string }> = {
	en: {
		viewBox: '0 0 60 30',
		markup: '<path d="M0 0h60v30H0z" fill="#012169"/><path d="m0 0 60 30M60 0 0 30" stroke="#FFFFFF" stroke-width="6"/><path d="m0 0 60 30M60 0 0 30" stroke="#C8102E" stroke-width="2"/><path d="M30 0v30M0 15h60" stroke="#FFFFFF" stroke-width="10"/><path d="M30 0v30M0 15h60" stroke="#C8102E" stroke-width="6"/>'
	},
	ro: {
		viewBox: '0 0 3 2',
		markup: '<path d="M0 0h1v2H0z" fill="#002B7F"/><path d="M1 0h1v2H1z" fill="#FCD116"/><path d="M2 0h1v2H2z" fill="#CE1126"/>'
	}
};

const { locale } = Astro.props;
const { viewBox, markup } = flags[locale];
---

<svg class="flag" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true" set:html={markup} />
