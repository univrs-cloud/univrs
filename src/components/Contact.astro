---
import { ui } from '../data/ui';
import { site, type Locale } from '../site';

interface Props {
	locale: Locale;
	id?: string;
	label?: string;
	title?: string;
	lede?: string;
	message?: string;
	send?: string;
	note?: string;
}

const { locale, id = 'contact' } = Astro.props;
const copy = ui[locale].contact;
const label = Astro.props.label ?? copy.label;
const title = Astro.props.title ?? copy.title;
const lede = Astro.props.lede ?? copy.lede;
const message = Astro.props.message ?? copy.message;
const send = Astro.props.send ?? copy.send;
const note = Astro.props.note ?? copy.note;
const closingLimit = note.length + 1 + copy.reply.length + 1 + 254;
const messageLimit = 5000 - closingLimit - 2;
---

<section class="bay bay--tight" id={id}>
	<div class="wrap">
		<header class="bay-head">
			<span class="label">{label}</span>
			<h2>{title}</h2>
			<p class="lede">{lede}</p>
		</header>
		<form
			class="contact"
			action={`${site.fleet}/messages`}
			method="post"
			novalidate
			data-note={note}
			data-reply={copy.reply}
			data-error-name={copy.errors.name}
			data-error-email={copy.errors.email}
			data-error-message={copy.errors.message}
			data-error-limit={copy.errors.limit}
			data-error-failed={copy.errors.failed}
		>
			<div class="contact-fields">
				<div class="contact-field">
					<label>
						<span>{copy.name}</span>
						<input type="text" name="name" autocomplete="name" maxlength="100" placeholder=" " aria-describedby={`${id}-name-error`} required>
					</label>
					<p class="contact-field-error" id={`${id}-name-error`}></p>
				</div>
				<div class="contact-field">
					<label>
						<span>{copy.email}</span>
						<input type="email" name="email" autocomplete="email" maxlength="254" placeholder=" " aria-describedby={`${id}-email-error`} required>
					</label>
					<p class="contact-field-error" id={`${id}-email-error`}></p>
				</div>
				<div class="contact-field contact-field--wide">
					<label>
						<span>{message}</span>
						<textarea name="message" rows="6" maxlength={messageLimit} placeholder=" " aria-describedby={`${id}-message-error`} required></textarea>
					</label>
					<p class="contact-field-error" id={`${id}-message-error`}></p>
				</div>
				<label class="contact-trap" aria-hidden="true">
					<span>Website</span>
					<input type="text" name="website" tabindex="-1" autocomplete="off">
				</label>
			</div>
			<div class="contact-foot">
				<button class="btn" type="submit">
					<span class="contact-idle">{send} <span class="arw" aria-hidden="true">→</span></span>
					<span class="contact-busy">{copy.sending}</span>
				</button>
				<p class="contact-error" role="alert"></p>
			</div>
			<div class="contact-done" role="status">
				<strong>{copy.sentTitle}</strong>
				<p>{copy.sentText}</p>
			</div>
		</form>
	</div>
</section>

<script>
	const form = document.querySelector<HTMLFormElement>('.contact');
	const error = form?.querySelector('.contact-error');
	const fields: Record<string, string> = { name: 'errorName', email: 'errorEmail', message: 'errorMessage' };

	const note = (input: Element) => input.closest('.contact-field')?.querySelector('.contact-field-error');

	const mark = (input: HTMLInputElement | HTMLTextAreaElement) => {
		const text = note(input);
		input.setAttribute('aria-invalid', 'true');
		if (form && text) {
			text.textContent = form.dataset[fields[input.name.toLowerCase()]] ?? '';
		}
	};

	const unmark = (input: Element) => {
		const text = note(input);
		input.removeAttribute('aria-invalid');
		if (text) {
			text.textContent = '';
		}
	};

	const validate = (input: HTMLInputElement | HTMLTextAreaElement) => {
		if (!input.value.trim() || !input.checkValidity()) {
			mark(input);
			return;
		}

		unmark(input);
	};

	const fail = (status: number, field: string) => {
		if (!form || !error) {
			return;
		}

		const input = (status !== 429 && fields[field.toLowerCase()] ? form.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${field.toLowerCase()}"]`) : null);
		if (input) {
			mark(input);
			input.focus();
			return;
		}

		error.textContent = (status === 429 ? form.dataset.errorLimit : form.dataset.errorFailed) ?? '';
	};

	const timeouts = new Map<Element, number>();

	form?.addEventListener('input', (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) || !input.required) {
			return;
		}

		window.clearTimeout(timeouts.get(input));
		timeouts.set(input, window.setTimeout(() => validate(input), 300));
	});

	form?.addEventListener('focusout', (event) => {
		const input = event.target;
		if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement) || !input.required) {
			return;
		}

		window.clearTimeout(timeouts.get(input));
		validate(input);
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!error || form.classList.contains('is-loading')) {
			return;
		}

		const values = Object.fromEntries(new FormData(form).entries());
		const closing = `${form.dataset.note} ${form.dataset.reply} ${String(values.email ?? '').trim()}`;
		const message = [String(values.message ?? '').trim(), closing].join('\n\n');
		const required = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[required]')];
		error.textContent = '';
		required.forEach(validate);
		const invalid = form.querySelector<HTMLElement>('[aria-invalid]');
		if (invalid) {
			invalid.focus();
			return;
		}

		form.classList.add('is-loading');
		try {
			const response = await fetch(form.action, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify({ topic: 'contact', ...values, message })
			});
			const result = await response.json().catch(() => ({}));
			if (response.ok && String(result.status).toLowerCase() === 'succeeded') {
				form.classList.add('is-sent');
				form.querySelector<HTMLElement>('.contact-done')?.focus();
				return;
			}

			fail(response.status, String(result.field ?? ''));
		} catch {
			fail(0, '');
		} finally {
			form.classList.remove('is-loading');
		}
	});
</script>
