---
interface Props {
	name: string;
}

const arts: Record<string, string> = {
	redundancy: `
		<line class="art-line" x1="70" y1="36" x2="90" y2="36"/>
		<g>
			<rect class="art-box" x="20" y="14" width="50" height="44" rx="6"/>
			<line class="art-line" x1="20" y1="44" x2="70" y2="44"/>
			<circle class="art-ok" cx="60" cy="51" r="2.6"/>
		</g>
		<g class="art-drive-b">
			<rect class="art-box" x="90" y="14" width="50" height="44" rx="6"/>
			<line class="art-line" x1="90" y1="44" x2="140" y2="44"/>
			<circle class="art-ok" cx="130" cy="51" r="2.6"/>
			<circle class="art-bad art-drive-b-led" cx="130" cy="51" r="2.6"/>
		</g>`,
	history: `
		<line class="art-line" x1="20" y1="36" x2="140" y2="36"/>
		<circle class="art-dot" cx="20" cy="36" r="3"/>
		<circle class="art-dot" cx="40" cy="36" r="3"/>
		<circle class="art-dot" cx="60" cy="36" r="3"/>
		<circle class="art-dot" cx="80" cy="36" r="3"/>
		<circle class="art-dot" cx="100" cy="36" r="3"/>
		<circle class="art-dot" cx="120" cy="36" r="3"/>
		<circle class="art-ok" cx="140" cy="36" r="3"/>
		<circle class="art-ring art-history-marker" cx="140" cy="36" r="8"/>`,
	ransomware: `
		<rect class="art-box art-snap" x="20" y="14" width="56" height="10" rx="3"/>
		<rect class="art-box art-snap" x="20" y="31" width="56" height="10" rx="3"/>
		<rect class="art-box art-snap" x="20" y="48" width="56" height="10" rx="3"/>
		<path class="art-ring art-restore" d="M82 36h14m-5-5 5 5-5 5"/>
		<g class="art-file">
			<rect class="art-box" x="104" y="16" width="36" height="40" rx="4"/>
			<line class="art-line" x1="111" y1="27" x2="133" y2="27"/>
			<line class="art-line" x1="111" y1="36" x2="133" y2="36"/>
			<line class="art-line" x1="111" y1="45" x2="125" y2="45"/>
		</g>
		<g class="art-file art-file-locked">
			<rect class="art-box" x="104" y="16" width="36" height="40" rx="4"/>
			<rect class="art-bad" x="115" y="35" width="14" height="11" rx="2"/>
			<path class="art-box" d="M118 35v-4a4 4 0 0 1 8 0v4"/>
		</g>`,
	integrity: `
		${[0, 1, 2].map((row) => [0, 1, 2, 3, 4, 5, 6, 7].map((column) => `<rect class="art-block" x="${26 + column * 14}" y="${13 + row * 16}" width="10" height="10" rx="2"/>`).join('')).join('')}
		<rect class="art-bad art-block-bad" x="96" y="29" width="10" height="10" rx="2"/>
		<line class="art-ring art-scan" x1="20" y1="7" x2="20" y2="65"/>`,
	search: `
		<line class="art-line art-row" x1="20" y1="16" x2="92" y2="16"/>
		<line class="art-line art-row" x1="20" y1="29" x2="76" y2="29"/>
		<line class="art-line art-row art-row-found" x1="20" y1="42" x2="98" y2="42"/>
		<line class="art-line art-row" x1="20" y1="55" x2="68" y2="55"/>
		<g class="art-lens">
			<circle class="art-ring" cx="118" cy="14" r="8"/>
			<line class="art-ring" x1="124" y1="20" x2="131" y2="27"/>
		</g>`,
	power: `
		<line class="art-line art-grid" x1="14" y1="36" x2="54" y2="36"/>
		<path class="art-ring art-grid" d="m32 22-6 11h7l-5 11"/>
		<rect class="art-box" x="54" y="24" width="24" height="24" rx="4"/>
		<circle class="art-ok" cx="66" cy="36" r="2.6"/>
		<line class="art-line" x1="78" y1="36" x2="96" y2="36"/>
		<rect class="art-box" x="96" y="23" width="42" height="26" rx="4"/>
		<rect class="art-box" x="138" y="31" width="4" height="10" rx="1"/>
		<rect class="art-ok art-level" x="100" y="27" width="34" height="18" rx="2"/>`
};

const { name } = Astro.props;
---

<svg class:list={['art', `art--${name}`]} viewBox="0 0 160 72" aria-hidden="true" set:html={arts[name]} />
