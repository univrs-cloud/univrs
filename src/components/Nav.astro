---
import { ui } from '../data/ui';
import { localePath, locales, site, type Locale } from '../site';
import BookIcon from './BookIcon.astro';
import Flag from './Flag.astro';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

interface Props {
	locale: Locale;
	alternates: Partial<Record<Locale, string>>;
}

const { locale, alternates } = Astro.props;
const copy = ui[locale];
const homePath = localePath(locale);
const blogPath = localePath(locale, 'blog/');
const supportPath = localePath(locale, 'support/');
const links = [
	{ href: `${homePath}#features`, text: copy.nav.features },
	{ href: `${homePath}#safety`, text: copy.nav.safety },
	{ href: `${homePath}#platform`, text: copy.nav.platform },
	{ href: `${homePath}#contact`, text: copy.nav.contact },
	{ href: blogPath, text: copy.nav.blog, current: Astro.url.pathname.startsWith(blogPath) },
	{ href: supportPath, text: copy.nav.support, current: Astro.url.pathname.startsWith(supportPath) }
];
---

<header class="nav">
	<div class="wrap nav-in">
		<a class="brand" href={homePath}>
			<Logo />
			<b>{site.name}</b>
		</a>
		<nav aria-label={copy.nav.menu}>
			<ul class="nav-list">
				{links.map(({ href, text, current }) => (
					<li><a href={href} aria-current={(current ? 'page' : undefined)}>{text}</a></li>
				))}
			</ul>
		</nav>
		<div class="nav-tools">
			<details class="lang">
				<summary>
					<span class="sr-only">{copy.language}: {copy.languageNames[locale]}</span>
					<Flag locale={locale} />
					<span class="lang-code" aria-hidden="true">{locale}</span>
					<svg class="lang-caret" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.500 3 3 3-3" /></svg>
				</summary>
				<ul class="lang-menu">
					{locales.map((other) => (
						<li>
							<a href={alternates[other] ?? localePath(other)} hreflang={other} lang={other} aria-current={(other.toLowerCase() === locale.toLowerCase() ? 'true' : undefined)}>
								<Flag locale={other} />
								{copy.languageNames[other]}
							</a>
						</li>
					))}
				</ul>
			</details>
			<a class="nav-icon" href={`${site.docs}/`} title={copy.nav.docs}>
				<span class="sr-only">{copy.nav.docs}</span>
				<BookIcon />
			</a>
			<a class="nav-icon" href={site.github} rel="me noopener">
				<span class="sr-only">GitHub</span>
				<svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .3a12 12 0 0 0-3.8 23.38c.6.12.83-.26.83-.57L9 21.07c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.09 1.83 1.24 1.83 1.24 1.08 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.14-.3-.54-1.52.1-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.28-1.55 3.29-1.23 3.29-1.23.64 1.66.24 2.88.12 3.18a4.65 4.65 0 0 1 1.23 3.22c0 4.61-2.8 5.63-5.48 5.92.42.36.81 1.1.81 2.22l-.01 3.29c0 .31.2.69.82.57A12 12 0 0 0 12 .3Z"/></svg>
			</a>
			<span class="nav-divider"></span>
			<button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label={copy.theme}>
				<span class="knob"></span>
				<span class="icon sun"><Icon name="sun" /></span>
				<span class="icon moon"><Icon name="moon" /></span>
			</button>
			<button class="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-mobile" aria-label={copy.nav.menu}>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>
	<nav class="nav-mobile" id="nav-mobile" aria-label={copy.nav.menu} hidden>
		<div class="wrap">
			<ul class="nav-list">
				{links.map(({ href, text, current }) => (
					<li><a href={href} aria-current={(current ? 'page' : undefined)}>{text}</a></li>
				))}
			</ul>
		</div>
	</nav>
</header>

<script>
	const storageKey = 'univrs-theme';
	const scheme = matchMedia('(prefers-color-scheme: dark)');
	const root = document.documentElement;
	const themeToggle = document.querySelector('.theme-toggle');
	const navToggle = document.querySelector('.nav-toggle');
	const navMobile = document.querySelector('.nav-mobile');
	const lang = document.querySelector('.lang');

	const storedTheme = () => {
		try {
			return localStorage.getItem(storageKey);
		} catch {
			return null;
		}
	};

	const syncTheme = () => {
		themeToggle?.setAttribute('aria-checked', String(root.dataset.theme === 'dark'));
	};

	const closeMenu = () => {
		navToggle?.setAttribute('aria-expanded', 'false');
		navMobile?.setAttribute('hidden', '');
	};

	syncTheme();

	scheme.addEventListener('change', () => {
		if (storedTheme()) {
			return;
		}

		root.dataset.theme = (scheme.matches ? 'dark' : 'light');
		syncTheme();
	});

	themeToggle?.addEventListener('click', () => {
		root.dataset.theme = (root.dataset.theme === 'dark' ? 'light' : 'dark');
		try {
			localStorage.setItem(storageKey, root.dataset.theme);
		} catch {}
		syncTheme();
	});

	navToggle?.addEventListener('click', () => {
		if (navMobile?.hasAttribute('hidden')) {
			navToggle.setAttribute('aria-expanded', 'true');
			navMobile.removeAttribute('hidden');
			return;
		}

		closeMenu();
	});

	document.addEventListener('click', (event) => {
		if (event.target instanceof Node && !lang?.contains(event.target)) {
			lang?.removeAttribute('open');
		}
	});

	document.addEventListener('keydown', (event) => {
		if (event.key.toLowerCase() === 'escape') {
			lang?.removeAttribute('open');
		}
	});

	navMobile?.addEventListener('click', (event) => {
		if (event.target instanceof HTMLAnchorElement) {
			closeMenu();
		}
	});
</script>
