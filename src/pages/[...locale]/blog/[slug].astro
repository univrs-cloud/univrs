---
import { getImage, Image } from 'astro:assets';
import { render } from 'astro:content';
import { allPosts, formatDate, postAlternates, postImagePath, postLocale, postMarkdownPath, postPath, postSlug, type Post } from '../../../data/posts';
import { ui } from '../../../data/ui';
import Base from '../../../layouts/Base.astro';
import { localePath, site } from '../../../site';

interface Props {
	post: Post;
}

export const getStaticPaths = async () => {
	const posts = await allPosts();

	return posts.map((post) => ({
		params: { locale: localePath(postLocale(post)).slice(1, -1) || undefined, slug: postSlug(post) },
		props: { post }
	}));
};

const { post } = Astro.props;
const { Content } = await render(post);
const locale = postLocale(post);
const slug = postSlug(post);
const copy = ui[locale].blog;
const { title, description, pubDate, updatedDate, image, imageAlt, tags } = post.data;
const shareImage = (image ? (await getImage({ src: image, width: 1200, height: 630, fit: 'cover', position: 'top', format: 'png' })).src : postImagePath(post));
const alternates = await postAlternates(post);
const pageUrl = new URL(postPath(post), Astro.site).href;
const blogUrl = new URL(localePath(locale, 'blog/'), Astro.site).href;
const schema = [
	{
		'@type': 'BlogPosting',
		'@id': `${pageUrl}#post`,
		headline: title,
		description,
		url: pageUrl,
		mainEntityOfPage: pageUrl,
		inLanguage: locale,
		datePublished: pubDate.toISOString(),
		dateModified: (updatedDate ?? pubDate).toISOString(),
		image: new URL(shareImage, Astro.site).href,
		keywords: tags,
		author: { '@id': `${site.url}/#organization` },
		publisher: { '@id': `${site.url}/#organization` }
	},
	{
		'@type': 'BreadcrumbList',
		itemListElement: [
			{ '@type': 'ListItem', position: 1, name: site.name, item: new URL(localePath(locale), Astro.site).href },
			{ '@type': 'ListItem', position: 2, name: copy.title, item: blogUrl },
			{ '@type': 'ListItem', position: 3, name: title, item: pageUrl }
		]
	}
];
---

<Base
	locale={locale}
	title={title}
	description={description}
	alternates={alternates}
	image={shareImage}
	type="article"
	published={pubDate}
	modified={updatedDate}
	markdown={postMarkdownPath(post)}
	schema={schema}
>
	<article>
		<header class="post-head">
			<div class="wrap wrap--reading">
				<span class="label">
					<a href={localePath(locale, 'blog/')}>{copy.label}</a> · <time datetime={pubDate.toISOString()}>{formatDate(pubDate, locale)}</time>
					{updatedDate && <> · {copy.updated} <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate, locale)}</time></>}
				</span>
				<h1 style={`view-transition-name: post-title-${slug}`}>{title}</h1>
				<p class="lede">{description}</p>
				<hr class="spectrum">
			</div>
		</header>
		<div class="wrap wrap--reading">
			{image && (
				<figure class="post-image" style={`view-transition-name: post-image-${slug}`}>
					<Image src={image} alt={imageAlt} widths={[720, 1440]} sizes="(max-width: 760px) 100vw, 720px" loading="eager" fetchpriority="high" />
				</figure>
			)}
			<div class="post-content" data-copy={copy.copy} data-copied={copy.copied}>
				<Content />
			</div>
			<footer class="post-foot">
				<ul class="post-tags">
					{tags.map((tag) => <li class="chip">{tag}</li>)}
				</ul>
				<a class="more" href={localePath(locale, 'blog/')}><span class="arw" aria-hidden="true">←</span> {copy.back}</a>
			</footer>
		</div>
	</article>
	<dialog class="zoom" data-label={copy.zoom}>
		<button class="zoom-close" type="button" aria-label={copy.zoomClose}>
			<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M21.71 2.29a1 1 0 0 0-1.42 0l-5.79 5.8V6.5a1 1 0 0 0-2 0v4a1 1 0 0 0 .08.38 1 1 0 0 0 .54.54 1 1 0 0 0 .38.08h4a1 1 0 0 0 0-2h-1.59l5.8-5.79a1 1 0 0 0 0-1.42ZM10.88 12.58a1 1 0 0 0-.38-.08h-4a1 1 0 0 0 0 2h1.59l-5.8 5.79a1 1 0 0 0 0 1.42 1 1 0 0 0 1.42 0l5.79-5.8v1.59a1 1 0 0 0 2 0v-4a1 1 0 0 0-.08-.38 1 1 0 0 0-.54-.54Z" /></svg>
		</button>
		<figure>
			<img alt="">
			<figcaption></figcaption>
		</figure>
	</dialog>
</Base>

<script>
	const DURATION = 300;
	const EASING = 'cubic-bezier(0.4, 0, 0.2, 1)';
	const dialog = document.querySelector<HTMLDialogElement>('.zoom');
	const enlarged = dialog?.querySelector('img');
	const caption = dialog?.querySelector('figcaption');
	let source: HTMLImageElement | null = null;
	let closing = false;

	const largestSource = (image: HTMLImageElement) => {
		const candidates = image.srcset.split(',').map((candidate) => candidate.trim().split(/\s+/)).filter(([url]) => url);
		const widest = candidates.sort((a, b) => parseInt(b[1] ?? '0', 10) - parseInt(a[1] ?? '0', 10))[0];

		return widest?.[0] ?? image.currentSrc ?? image.src;
	};

	const travel = (from: HTMLImageElement, to: HTMLImageElement) => {
		const start = from.getBoundingClientRect();
		const end = to.getBoundingClientRect();

		return `translate(${start.left - end.left}px, ${start.top - end.top}px) scale(${start.width / end.width})`;
	};

	const close = async () => {
		if (!dialog || !enlarged || !source || closing) {
			return;
		}

		closing = true;
		dialog.classList.remove('is-open');
		await enlarged.animate([{ transform: 'none' }, { transform: travel(source, enlarged) }], { duration: DURATION, easing: EASING }).finished;
		dialog.close();
		source.style.visibility = '';
		source.focus({ preventScroll: true });
		source = null;
		closing = false;
	};

	const open = async (image: HTMLImageElement) => {
		if (!dialog || !enlarged || !caption || source) {
			return;
		}

		source = image;
		enlarged.src = largestSource(image);
		enlarged.alt = image.alt;
		caption.textContent = image.alt;
		await enlarged.decode().catch(() => {});
		dialog.showModal();
		enlarged.animate([{ transform: travel(image, enlarged) }, { transform: 'none' }], { duration: DURATION, easing: EASING });
		image.style.visibility = 'hidden';
		requestAnimationFrame(() => dialog.classList.add('is-open'));
		window.addEventListener('wheel', close, { once: true });
	};

	document.querySelectorAll<HTMLImageElement>('.post-image img, .post-content img').forEach((image) => {
		image.tabIndex = 0;
		image.setAttribute('role', 'button');
		image.setAttribute('aria-label', `${dialog?.dataset.label}: ${image.alt}`);
		image.addEventListener('click', () => open(image));
		image.addEventListener('keydown', (event) => {
			if (['enter', ' '].includes(event.key.toLowerCase())) {
				event.preventDefault();
				open(image);
			}
		});
	});

	dialog?.addEventListener('click', close);
	dialog?.addEventListener('cancel', (event) => {
		event.preventDefault();
		close();
	});
	window.addEventListener('resize', close);

	const SHELL_LANGUAGES = ['sh', 'bash', 'shell', 'zsh'];
	const SESSION_LANGUAGES = ['console', 'shellsession'];
	const COPIED_MS = 1500;
	const COPY_ICON = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M3 19a2 2 0 0 1-1-2V2a2 2 0 0 1 1-1h13a2 2 0 0 1 2 1" /><rect x="6" y="5" width="16" height="18" rx="1.5" ry="1.5" /></svg>';
	const content = document.querySelector<HTMLElement>('.post-content');

	content?.querySelectorAll<HTMLPreElement>('pre').forEach((block) => {
		const language = (block.dataset.language ?? '').toLowerCase();
		const hasPrompt = SHELL_LANGUAGES.includes(language);
		const isShell = hasPrompt || SESSION_LANGUAGES.includes(language);
		const frame = document.createElement('figure');
		const head = document.createElement('div');
		const label = document.createElement('span');
		const button = document.createElement('button');
		let timer: number | undefined;

		frame.className = `code-frame${isShell ? ' is-shell' : ''}${hasPrompt ? ' has-prompt' : ''}`;
		head.className = 'code-head';
		label.className = 'code-label';
		label.textContent = (isShell ? 'Shell' : '');
		button.className = 'code-copy';
		button.type = 'button';
		button.title = content.dataset.copy ?? '';
		button.setAttribute('aria-label', content.dataset.copy ?? '');
		button.dataset.copied = content.dataset.copied ?? '';
		button.innerHTML = COPY_ICON;
		button.addEventListener('click', async () => {
			await navigator.clipboard.writeText(block.querySelector('code')?.innerText ?? block.innerText);
			button.classList.add('is-copied');
			window.clearTimeout(timer);
			timer = window.setTimeout(() => button.classList.remove('is-copied'), COPIED_MS);
		});

		head.append(label, button);
		block.replaceWith(frame);
		frame.append(head, block);
	});
</script>
